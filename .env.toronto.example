# Environment for the Toronto production deployment (docker-compose.toronto.yml).
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.
#
# The compose file falls back to safe dev placeholders when a var is unset, so
# only the secrets below MUST be provided in production.

# --- Database (db + cms + bankruptcy-ingest all read this) ---
# Real production password lives only in the server-side .env.
POSTGRES_PASSWORD=change-me

# --- Payload CMS ---
# Session/JWT signing + field encryption. Changing it invalidates sessions, so
# keep the live value stable. Min 32 chars.
PAYLOAD_SECRET=change-me-min-32-characters-long!!
SERVER_URL=https://sudacka-mreza.hr
FRONTEND_URL=https://sudacka-mreza.hr
CONTACT_EMAIL=info@sudacka-mreza.hr

# --- PII field encryption (court-decision citizen data) ---
# 32-byte key; the cms reads it from the env, the .pii-key file holds a copy.
PII_ENCRYPTION_KEY=

# --- Legal-AI / RAG (chat + semantic search) ---
RAG_URL=
RAG_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=
EMBED_MODEL=
CHAT_NUM_CTX=
RETRIEVAL_TOP_K=
RETRIEVAL_CANDIDATE_K=
ENABLE_RERANK=
LLM_API_TOKEN=

# --- Email relays (2FA, filing notifications) ---
RESEND_API_KEY=
MAILGUN_SIGNING_KEY=
ADMIN_NOTIFY_EMAIL=admin@sudacka-mreza.hr

# --- Feature flags ---
# MFA (email-OTP for admins) is DISABLED by default. Set to "true" to enable it.
# ENABLE_MFA=true
