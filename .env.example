# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=sudacka_mreza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── CMS (Payload) ─────────────────────────────────────────────────────────────
# PAYLOAD_SECRET must be at least 32 characters — generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=dev-secret-change-in-prod-min-32-chars!!
DATABASE_URI=postgresql://postgres:postgres@db:5432/sudacka_mreza
PORT=4094
SERVER_URL=http://localhost:4094
FRONTEND_URL=http://localhost:5173

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_EMAIL=info@sudacka-mreza.hr

# ── Frontend build ────────────────────────────────────────────────────────────
# Baked into the Vite static bundle at build time (not a runtime secret).
# In Docker Compose this is passed as a build arg and defaults to http://cms:4094.
# For local `vite dev`, the Vite proxy forwards /api/* to this URL automatically.
VITE_CMS_URL=http://localhost:4094

# ── Jurisdiction finder (FR-014) ──────────────────────────────────────────────
# Absolute path to the GeoJSON file containing Croatian court jurisdiction polygons.
# This is a client-provided file (spec §D5). Leave blank to disable the feature.
JURISDICTION_GEOJSON_PATH=

# ── eSPIS Integration ─────────────────────────────────────────────────────────
# Croatia's official court information system (eSpis).
# Leave blank until API access is granted by Ministarstvo pravosuđa i uprave.
# When credentials are obtained, also flip MockEspisClient → RealEspisClient
# in cms/src/integrations/espis.ts.
ESPIS_API_URL=
ESPIS_API_KEY=
# Set to "true" to write to the database (default: mock/log-only mode)
ESPIS_SYNC_ENABLED=false
# How many hours back to look for new decisions on each sync run (default: 24)
ESPIS_SYNC_WINDOW_HOURS=24

# ── Production (Caddy / TLS) ──────────────────────────────────────────────────
# The public domain Caddy will request a Let's Encrypt certificate for.
DOMAIN=sudacka-mreza.hr
