# Database
POSTGRES_DB=sudacka_mreza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# CMS
DATABASE_URI=postgresql://postgres:postgres@db:5432/sudacka_mreza
PAYLOAD_SECRET=dev-secret-change-in-prod
PORT=4094

# Email (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=info@sudacka-mreza.hr

# Server
SERVER_URL=http://localhost:4094
FRONTEND_URL=http://localhost:5173

# Jurisdiction finder (FR-014)
# Path to the GeoJSON file containing Croatian court jurisdiction polygons.
# Required for GET /api/jurisdiction to work. This is a client-provided file (spec D5).
JURISDICTION_GEOJSON_PATH=
